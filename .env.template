# =============================================================================
# zomi-g2p — environment template
# =============================================================================
# Copy this file to `.env` and fill in the values:
#
#     cp .env.template .env
#
# `.env` is gitignored. Never commit real tokens or URLs.
# =============================================================================


# -----------------------------------------------------------------------------
# Lexicon source (used by scripts/fetch_lexicon.py)
# -----------------------------------------------------------------------------
# Google Sheets document ID. This is the long string in the sheet URL:
#   https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
ZOMI_LEXICON_SHEET_ID=

# Sheet tab GID. Found in the URL fragment after `#gid=`:
#   https://docs.google.com/spreadsheets/d/<ID>/edit#gid=<GID>
# Use "0" for the first tab.
ZOMI_LEXICON_SHEET_GID=0

# Optional: name of the worksheet within the sheet (informational only).
# The current fetch script uses the GID, not the name, but logging it
# helps maintainers confirm they're fetching the right tab.
ZOMI_LEXICON_SHEET_NAME=lexicon

# Optional: local path to a previously downloaded CSV, used to skip the
# network call during development. If set, fetch_lexicon.py reads from
# this path instead of downloading. Useful for offline work and for
# reproducing a specific snapshot.
# ZOMI_LEXICON_LOCAL_CSV=


# -----------------------------------------------------------------------------
# Build artifacts
# -----------------------------------------------------------------------------
# Directory where the fetched CSV and built pickle are written.
# Defaults to src/zomi_g2p/data if unset.
# ZOMI_DATA_DIR=src/zomi_g2p/data


# -----------------------------------------------------------------------------
# Logging (maintainer scripts)
# -----------------------------------------------------------------------------
# Python logging level for scripts/fetch_lexicon.py and scripts/build_pickle.py.
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
ZOMI_LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# Publishing (CI / local twine uploads)
# -----------------------------------------------------------------------------
# These are read by twine and by the GitHub Actions publish workflow.
# In CI, set them as repository secrets, not as .env entries.
#
# For local uploads only — do not commit a .env with these filled in.
#
# TWINE_USERNAME=__token__
# TWINE_PASSWORD=pypi-...
#
# TestPyPI uses the same variable names; pass --repository testpypi to twine.
# TWINE_REPOSITORY=testpypi
# TWINE_REPOSITORY_URL=https://test.pypi.org/legacy/


# -----------------------------------------------------------------------------
# Development overrides (optional)
# -----------------------------------------------------------------------------
# Force the loader to ignore lexicon.pkl and parse the CSV, to test the
# fallback path. Set to "1" to disable the pickle.
# ZOMI_DISABLE_PICKLE=

# Path to an alternate lexicon directory for local testing, used by
# `zomi-g2p --lexicon`. Not read by the package itself — only convenient
# for shell aliases during development.
# ZOMI_DEV_LEXICON_DIR=